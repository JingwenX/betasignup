# Postgres connection string used by lib/db.
#
# Not normally set by hand: `vercel env pull .env.local` provides the Supabase
# integration's own variables (betasignup_POSTGRES_URL and friends), which the
# app reads directly. Set DATABASE_URL only to override with a different
# database locally - it takes precedence when present.
DATABASE_URL=

# Passcode for /admin. Defaults to 3421 when unset.
ADMIN_PASSCODE=

# Secret used to sign the /admin session cookie.
# Defaults to a value derived from ADMIN_PASSCODE; set your own in production.
ADMIN_SECRET=
