# Postgres connection string used by lib/db.
# Vercel's Supabase/Neon integrations set POSTGRES_URL instead; either works,
# and `vercel env pull .env.local` will populate whichever yours provides.
# Prefer the pooled URL (Supabase: "Transaction pooler") on serverless.
DATABASE_URL=

# Passcode for /admin. Defaults to 3421 when unset.
ADMIN_PASSCODE=

# Secret used to sign the /admin session cookie.
# Defaults to a value derived from ADMIN_PASSCODE; set your own in production.
ADMIN_SECRET=
