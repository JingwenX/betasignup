# Supabase Postgres connection string used by lib/db.
# Prefer the pooled ("Transaction pooler") URL on serverless.
# `vercel env pull .env.local` populates this from the Vercel project.
DATABASE_URL=

# Passcode for /admin. Defaults to 3421 when unset.
ADMIN_PASSCODE=

# Secret used to sign the /admin session cookie.
# Defaults to a value derived from ADMIN_PASSCODE; set your own in production.
ADMIN_SECRET=
